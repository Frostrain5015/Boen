{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@boen/shared": ["../../packages/shared/src/index.ts"],
      "@boen/agent-core": ["../../packages/agent-core/src/index.ts"]
    }
  },
  "include": ["src"]
}
